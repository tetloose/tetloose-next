{
  "name": "tetloose-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm run prepare && npm run dev",
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./app ./src",
    "lint:fix": "eslint ./app ./src --fix",
    "lint:css": "stylelint \"./app/**/*.css\" \"./src/**/*.css\"",
    "lint:css:fix": "stylelint \"./app/**/*.css\" \"./src/**/*.css\" --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "watch:typescript": "tsc --noEmit --watch",
    "watch:eslint": "chokidar 'app/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' -c 'eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"'",
    "watch:styles": "chokidar 'app/**/*.css' 'src/**/*.css' -c 'stylelint \"app/**/*.css\" \"src/**/*.css\"'",
    "watch": "concurrently --names \"TypeScript,Eslint,Styles\" --prefix \"[{name}]\" --prefix-colors \"green,magenta,yellow\" \"npm run watch:typescript\" \"npm run watch:eslint\" \"npm run watch:styles\"",
    "gen:component": "plop",
    "git:branch": "node .scripts/git-branch.mjs",
    "git:commit": "node .scripts/git-commit.mjs",
    "git:pr": "node .scripts/git-pr.mjs",
    "lint-staged": "lint-staged",
    "commit-msg": "commitlint --edit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "15.5.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@inquirer/prompts": "^8.4.2",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-designs": "^11.1.0",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/nextjs-vite": "^10.1.4",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-storybook": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.7",
    "plop": "^4.0.5",
    "postcss": "^8.5.10",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-hook-form": "^7.64.0",
    "storybook": "^10.1.4",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "none",
    "printWidth": 120,
    "allowParens": "avoid"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  }
}
